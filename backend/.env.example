PORT=8000
APP_ENV=development

# Leave unset to use the local SQLite file (sqlite:///./members.db).
# On Render, set to the PostgreSQL connection string.
# DATABASE_URL=

# Leave unset to allow all CORS origins. Set to the deployed frontend URL
# in production.
# ALLOWED_ORIGIN=

# --- Admin access (required) ---------------------------------------------
# The password for the admin dashboard. Without it, /auth/login answers 503
# and the member endpoints reject every caller - nobody can read or write
# member data. Set a long, unique value; it is the only thing standing in
# front of personal records.
ADMIN_PASSWORD=123456

# Key used to sign session tokens. Optional: defaults to a value derived from
# ADMIN_PASSWORD, which means changing the password logs everyone out. Set it
# explicitly to a long random string if you would rather sessions survive a
# password change.
# ADMIN_SESSION_SECRET=

# How long a login lasts, in hours. Default 12.
# ADMIN_SESSION_HOURS=12
